# =============================================================================
# LOCAL (teste) — OrbStack + Supabase
#   1. OrbStack Running (macOS Sonoma 14+)
#   2. pnpm dev  → abre OrbStack, sobe o DB, inicia o Vite
#   3. Uma vez: pnpm db:status → copiar keys abaixo
#
# PRODUÇÃO (Vercel) — NÃO use estas vars locais no deploy.
# Configure no painel Vercel as keys do projeto Supabase Cloud.
# =============================================================================

# Supabase
SUPABASE_PROJECT_ID=""
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Google Drive (armazenamento de arquivos — ver GOOGLE_DRIVE_SETUP.md)
# Em local, uploads (comprovantes/depósitos/PDF) falham sem credenciais; o resto do app funciona.
GOOGLE_DRIVE_FOLDER_ID=""
# JSON da service account em uma linha:
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Ou caminho para o arquivo JSON (apenas dev local):
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
